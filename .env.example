# Wrangler reads secrets from .dev.vars (see .dev.vars.example). This file is
# kept for tooling that expects .env. Never commit real values.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/
MONGODB_DATABASE=rotsi_payments_dev
MASTER_KEY=
INTERNAL_ADMIN_TOKEN=
PUBLIC_BASE_URL=https://your-tunnel.example.com
